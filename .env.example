# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# telegram id админов через запятую — доступ к /stats
ADMIN_IDS=
# username бота без @ — для ссылок-приглашений; пусто — узнаём у Telegram
BOT_USERNAME=

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
COMPANION_MODEL=google/gemini-3.8-flash
COMPANION_FALLBACK_MODEL=qwen/qwen3-vl-235b-a22b-instruct
# дешевле: deepseek/deepseek-v4-flash
ANALYST_MODEL=google/gemini-3.5-flash-lite
SUMMARY_MODEL=google/gemini-3.5-flash-lite
# none|minimal|low|medium|high; пусто — параметр не передаётся
COMPANION_REASONING_EFFORT=minimal
ANALYST_REASONING_EFFORT=minimal

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
STT_MODEL=scribe_v2
STT_LANGUAGE=en
TTS_MODEL=eleven_flash_v2_5
# Ogg/Opus сразу годится для sendVoice; mp3_* сконвертирует ffmpeg
TTS_OUTPUT_FORMAT=opus_48000_64
# Will (premade, американский, молодой мужской) — голос Джейка
VOICE_US_CASUAL=bIHbv24MWmeRgasZH58o
# Alice (premade, британский женский) — голос Эммы
VOICE_UK_CASUAL=Xb7hH8MSUJpSbSDYk0k2
# цены для учёта расходов в таблице usage (стоимость LLM OpenRouter отдаёт сам)
STT_USD_PER_HOUR=0.22
TTS_USD_PER_1K_CHARS=0.04

# --- БД ---
DATABASE_URL=postgresql+asyncpg://bot:bot@db:5432/bot

# --- Лимиты и поведение ---
DAILY_MSG_LIMIT=50
DAILY_TTS_LIMIT=20
HISTORY_WINDOW=12
SUMMARY_TRIGGER=30
MAX_VOICE_SECONDS=60
TTS_MAX_CHARS=400
REVIEW_EVERY=10
SHOW_TRANSCRIPT=true
LOG_LEVEL=INFO

# --- Премиум (выдаётся в админке Mini App или покупается за звёзды) ---
PREMIUM_DAILY_MSG_LIMIT=200
# голос — главная статья расходов: 40 озвучек в день — разумный «честный» лимит (см. финмодель)
PREMIUM_DAILY_TTS_LIMIT=100
# цены в звёздах Telegram (фича «Оплата звёздами» в админке, по умолчанию выключена)
STARS_MONTH=350
STARS_QUARTER=900
STARS_YEAR=2400

# --- Mini App: уроки, прогресс, админка ---
# Домен, на который смотрит A-запись сервера. Без своего домена: <ip-через-дефисы>.sslip.io
WEBAPP_DOMAIN=
LESSON_MODEL=google/gemini-3.8-flash
LESSON_REASONING_EFFORT=low
DAILY_LESSON_LIMIT=1
PREMIUM_DAILY_LESSON_LIMIT=3
# формат аудио для аудирования в браузере Telegram
LESSON_AUDIO_FORMAT=mp3_44100_64
